<Window x:Class="EMS.Dialogs.NameInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="输入名称" Height="170" Width="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtPrompt" Grid.Row="0" Margin="0,0,0,8" />
        <TextBox x:Name="TxtName" Grid.Row="1" VerticalAlignment="Top" Padding="5"
                 KeyDown="TxtName_KeyDown" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" Width="80" Height="30" Margin="0,0,10,0"
                    Click="BtnOk_Click" IsDefault="True" />
            <Button Content="取消" Width="80" Height="30"
                    Click="BtnCancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
