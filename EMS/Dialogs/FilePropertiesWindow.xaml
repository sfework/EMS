<Window x:Class="EMS.Dialogs.FilePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="文件属性" 
        Height="450" 
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 文件信息 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock x:Name="FileNameText" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock x:Name="FilePathText" Foreground="Gray" FontSize="12"/>
            <TextBlock x:Name="FileTypeText" Foreground="Gray" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- 权限设置 -->
        <GroupBox Grid.Row="1" Header="权限" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 所有者 -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="所有者" FontWeight="Bold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="OwnerReadCheck" Content="读取 (r)" Margin="0,5"/>
                    <CheckBox x:Name="OwnerWriteCheck" Content="写入 (w)" Margin="0,5"/>
                    <CheckBox x:Name="OwnerExecuteCheck" Content="执行 (x)" Margin="0,5"/>
                </StackPanel>

                <!-- 组 -->
                <StackPanel Grid.Column="1" Margin="5,0">
                    <TextBlock Text="组" FontWeight="Bold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="GroupReadCheck" Content="读取 (r)" Margin="0,5"/>
                    <CheckBox x:Name="GroupWriteCheck" Content="写入 (w)" Margin="0,5"/>
                    <CheckBox x:Name="GroupExecuteCheck" Content="执行 (x)" Margin="0,5"/>
                </StackPanel>

                <!-- 其他 -->
                <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="其他" FontWeight="Bold" Margin="0,0,0,10"/>
                    <CheckBox x:Name="OthersReadCheck" Content="读取 (r)" Margin="0,5"/>
                    <CheckBox x:Name="OthersWriteCheck" Content="写入 (w)" Margin="0,5"/>
                    <CheckBox x:Name="OthersExecuteCheck" Content="执行 (x)" Margin="0,5"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 八进制显示 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="10,0,10,10">
            <TextBlock Text="八进制表示：" Foreground="Gray" FontSize="11"/>
            <TextBlock x:Name="OctalText" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Foreground="#4EC9B0"/>
        </StackPanel>

        <!-- 按钮 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="确定" Width="80" Margin="0,0,10,0" Click="OK_Click" IsDefault="True"/>
            <Button Content="取消" Width="80" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>