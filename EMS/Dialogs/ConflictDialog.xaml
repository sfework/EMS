<Window x:Class="EMS.Dialogs.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="目标已存在" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,6"
                   Text="{Binding Message, RelativeSource={RelativeSource AncestorType=Window}}" />
        <TextBlock Grid.Row="1" Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   Text="选择“替换”将用源文件覆盖目标；选择“跳过”则保留目标、不传输该项。" />

        <CheckBox x:Name="ChkApplyAll" Grid.Row="2" Content="为以下所有冲突项执行此操作"
                  VerticalAlignment="Bottom" IsChecked="True" Margin="0,4,0,10" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnReplace" Content="替换" Width="90" Height="30" Margin="0,0,10,0"
                    Click="BtnReplace_Click" IsDefault="True" />
            <Button x:Name="BtnSkip" Content="跳过" Width="90" Height="30" Margin="0,0,10,0"
                    Click="BtnSkip_Click" />
            <Button x:Name="BtnCancel" Content="取消" Width="90" Height="30"
                    Click="BtnCancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
