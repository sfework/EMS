<Window x:Class="EMS.Dialogs.TextEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="文本编辑器" 
        Height="600" 
        Width="800"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <avalonEdit:TextEditor x:Name="Editor" 
                               FontFamily="Consolas" 
                               FontSize="12"
                               ShowLineNumbers="True"
                               SyntaxHighlighting="XML"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="保存" Width="80" Height="30" Margin="0,0,10,0" Click="Save_Click"/>
            <Button Content="取消" Width="80" Height="30" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>