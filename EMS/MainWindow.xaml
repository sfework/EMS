<Window x:Class="EMS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EMS"
        
        xmlns:viewmodels="clr-namespace:EMS.ViewModels"
        xmlns:converters="clr-namespace:EMS.Converters"
        mc:Ignorable="d"
        Title="EMS" Height="700" Width="1000" WindowStartupLocation="Manual"
        Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <converters:ServerStatusToIconConverter x:Key="ServerStatusToIconConverter" />
        <converters:GroupExpanderIconConverter x:Key="GroupExpanderIconConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:StatusToColorConverter x:Key="StatusToColorConverter" />
        <converters:ConnectActionConverter x:Key="ConnectActionConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Menu IsMainMenu="True" Grid.Row="0" Padding="5,0">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建群组(_N)" Command="{Binding NewGroupCommand}" />
                <Separator ></Separator>
                <MenuItem Header="退出(_X)" Click="MenuItem_Exit_Click"></MenuItem >
            </MenuItem >
            <MenuItem Header="服务(_S)">
                <MenuItem Header="MCP 设置(_M)" Command="{Binding McpSettingsCommand}" />
            </MenuItem >
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="关于(_A)"></MenuItem>
            </MenuItem>
        </Menu>
        <Grid  Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="200" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TreeView x:Name="ServerTreeView"
                          ItemsSource="{Binding Groups}"
                          SelectedItemChanged="TreeView_SelectedItemChanged"
                          PreviewMouseRightButtonDown="TreeView_PreviewMouseRightButtonDown"
                          MouseDoubleClick="ServerTreeView_MouseDoubleClick"
                                                    VirtualizingStackPanel.IsVirtualizing="False"
                          VirtualizingStackPanel.VirtualizationMode="Standard"
                          BorderThickness="0">
                    <TreeView.Resources>
                        <HierarchicalDataTemplate DataType="{x:Type viewmodels:GroupViewModel}" 
                                                  ItemsSource="{Binding Servers}">
                            <Border HorizontalAlignment="Stretch" MinHeight="32" Padding="10,0"
                                    Background="Transparent"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="新增服务器"
                                                  Command="{Binding PlacementTarget.Tag.AddServerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="编辑群组"
                                                  Command="{Binding PlacementTarget.Tag.EditGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="删除群组"
                                                  Command="{Binding PlacementTarget.Tag.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Image Width="16" Height="16" Margin="0,0,5,0" 
                                           Source="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource GroupExpanderIconConverter}}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="13" />
                                </StackPanel>
                            </Border>
                        </HierarchicalDataTemplate>

                        <DataTemplate DataType="{x:Type viewmodels:ServerViewModel}">
                            <Border HorizontalAlignment="Stretch" MinHeight="28" Padding="25,0,5,0"
                                    Background="Transparent"
                                    ToolTip="{Binding ErrorMessage}"
                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=TreeView}}">
                                <Border.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.ConnectOrDisconnectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Header>
                                                <TextBlock Text="{Binding IsConnected, Converter={StaticResource ConnectActionConverter}}" />
                                            </MenuItem.Header>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="编辑服务器"
                                                  Command="{Binding PlacementTarget.Tag.EditServerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="删除服务器"
                                                  Command="{Binding PlacementTarget.Tag.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Width="12" Height="12" Margin="0,0,5,0" 
                                           Source="{Binding StatusIcon, Converter={StaticResource ServerStatusToIconConverter}}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </TreeView.Resources>
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="False" />
                            <!-- 透明背景使整行（含空白处）参与命中测试，右键/双击任意位置有效 -->
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Padding" Value="0,2" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            
                                            <Border x:Name="Bd"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter x:Name="PART_Header"
                                                                 ContentSource="Header"
                                                                 HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            </Border>
                                            
                                            <ItemsPresenter x:Name="ItemsHost"
                                                           Grid.Row="1"
                                                           Visibility="Collapsed" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsExpanded" Value="True">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD" />
                                            </Trigger>
                                            <MultiTrigger>
                                                <MultiTrigger.Conditions>
                                                    <Condition Property="IsSelected" Value="True" />
                                                    <Condition Property="IsSelectionActive" Value="False" />
                                                </MultiTrigger.Conditions>
                                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0" />
                                            </MultiTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
            <GridSplitter x:Name="MainGridSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />
            <Grid x:Name="WorkspaceGrid" Grid.Column="2" SizeChanged="WorkspaceGrid_SizeChanged">
                <TabControl ItemsSource="{Binding TabItems}"
                            SelectedItem="{Binding SelectedTabItem}"
                            BorderThickness="0">
                    
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Header}" Height="0" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- 已连接时显示 RDP 控件 -->
                                <ContentControl Content="{Binding DisplayContent}" 
                                                Visibility="{Binding DisplayContent, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverted}" />
                                
                                <!-- 未连接/连接中/异常时显示状态信息 -->
                                <Border Background="#F5F5F5" 
                                        Visibility="{Binding DisplayContent, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding StatusMessage}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               TextAlignment="Center"
                                               Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                               Margin="20" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                    <TabControl.Style>
                        <Style TargetType="TabControl">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabControl">
                                        <Grid ClipToBounds="True">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="0" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <TabPanel Grid.Row="0" 
                                                      IsItemsHost="True" 
                                                      Margin="0"
                                                       />
                                            <Border Grid.Row="1" 
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    Background="{TemplateBinding Background}">
                                                <ContentPresenter ContentSource="SelectedContent" />
                                            </Border>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Style>
                </TabControl>
            </Grid>
        </Grid>
        <StatusBar Grid.Row="2" FlowDirection="RightToLeft" Padding="6,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText1}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding StatusBarText2}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>