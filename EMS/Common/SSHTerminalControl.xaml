<UserControl x:Class="EMS.Common.SSHTerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:common="clr-namespace:EMS.Common"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <common:FileEntryToIconConverter x:Key="FileIcon"/>
        <!-- 嵌入模式（RDP+SSH 组合视图内）：TabControl 只显示内容、不显示页签条，
             使整个视图只有外层一级页签，不出现"命令终端页签里又套命令终端页签" -->
        <Style x:Key="ChromeLessTabControl" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <TabControl x:Name="RootTabs">
        <!-- 第一页：SSH 命令终端。真实交互式 Shell：直接在上方输出区点击聚焦后键入即可
             （远端 shell 自带回显），不再有底部输入框——命令走 ShellStream 通道，
             经非交互通道执行不会在终端回显，输入框方案无法做到所见即所得 -->
        <TabItem Header="📟 命令终端">
            <!-- 非只读但拦截一切本地编辑事件（PreviewTextInput/Down 置 Handled），
                 既保证 TextInput 事件正常触发（IME/符号兼容），本地又不会插入内容 -->
            <avalonEdit:TextEditor x:Name="TerminalOutput" 
                                  FontFamily="Consolas" 
                                  FontSize="12"
                                  Background="#1E1E1E"
                                  Foreground="#D4D4D4"
                                  IsReadOnly="False"
                                  ShowLineNumbers="False"
                                  Padding="7"
                                  WordWrap="True"
                                  PreviewKeyDown="TerminalOutput_PreviewKeyDown"
                                  PreviewTextInput="TerminalOutput_PreviewTextInput"
                                  MouseLeftButtonUp="TerminalOutput_Focus"/>
        </TabItem>

        <!-- 第二页：文件管理器（单栏远程资源管理器） -->
                <TabItem Header="📁 文件管理" x:Name="FileManagerTab">
            <Grid>
                <!-- 文件管理主体：传输进行中整体禁用并被遮罩覆盖 -->
                <Grid x:Name="FileManagerRoot" Margin="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 工具栏：路径 / 向上 / 刷新 / 切换视图 -->
                        <Grid Grid.Row="0" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="路径：" VerticalAlignment="Center" Margin="0,0,6,5"/>
                            <TextBox Grid.Column="1" x:Name="RemotePathBox" Margin="0,0,6,5" VerticalContentAlignment="Center" KeyDown="RemotePathBox_KeyDown"/>
                            <Button Grid.Column="2" Width="30" Height="26" Margin="0,0,5,5" Click="RemoteUp_Click" ToolTip="上一级"
                                    Content="&#xE70E;" FontFamily="Segoe MDL2 Assets"/>
                            <Button Grid.Column="3" x:Name="RemoteRefreshButton" Width="30" Height="26" Margin="0,0,5,5" Click="RemoteRefresh_Click" ToolTip="刷新">
                                <Grid Width="16" Height="16">
                                    <TextBlock x:Name="RefreshGlyph" Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <!-- 加载指示：可见时自动旋转 -->
                                    <Path x:Name="RefreshSpinner" Visibility="Collapsed" Width="16" Height="16"
                                          Stroke="#0078D4" StrokeThickness="2" StrokeStartLineCap="Round"
                                          RenderTransformOrigin="0.5,0.5"
                                          Data="M 8,1 A 7,7 0 1 1 1,8">
                                        <Path.RenderTransform>
                                            <RotateTransform/>
                                        </Path.RenderTransform>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <Trigger Property="Visibility" Value="Visible">
                                                        <Trigger.EnterActions>
                                                            <BeginStoryboard Name="RefreshSpin">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Angle"
                                                                                   From="0" To="360" Duration="0:0:0.9"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </Trigger.EnterActions>
                                                        <Trigger.ExitActions>
                                                            <RemoveStoryboard BeginStoryboardName="RefreshSpin"/>
                                                        </Trigger.ExitActions>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>
                            <Button Grid.Column="4" Width="30" Height="26" Margin="0,0,0,5" Click="ViewToggle_Click" ToolTip="切换视图">
                                <!-- 初始为图标视图，按钮提示可切换到列表视图 -->
                                <TextBlock x:Name="ViewToggleGlyph" Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- 详情视图（列表，可切换） -->
                        <ListView x:Name="RemoteFileList" Grid.Row="1" Visibility="Collapsed"
                                  MouseDoubleClick="RemoteFileList_MouseDoubleClick"
                                  SelectionMode="Extended"
                                  AllowDrop="True"
                                  Drop="RemoteFileList_Drop"
                                  DragOver="RemoteFileList_DragOver"
                                  PreviewKeyDown="RemoteFileList_PreviewKeyDown"
                                  PreviewMouseRightButtonDown="RemoteFileList_PreviewMouseRightButtonDown"
                                  ContextMenuOpening="RemoteFileList_ContextMenuOpening">
                            <ListView.ContextMenu>
                                <ContextMenu x:Name="RemoteContextMenu">
                                    <MenuItem x:Name="RemoteEditMenu" Header="编辑" Click="RemoteQuickEdit_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="RemoteCopyMenu" Header="复制" InputGestureText="Ctrl+C" Click="RemoteCopy_Click"/>
                                    <MenuItem x:Name="RemotePasteMenu" Header="粘贴" InputGestureText="Ctrl+V" Click="RemotePaste_Click"/>
                                    <MenuItem x:Name="RemoteRenameMenu" Header="重命名" InputGestureText="F2" Click="RemoteRename_Click"/>
                                    <Separator/>
                                    <MenuItem Header="新建文件夹" Click="RemoteNewFolder_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="RemotePropertiesMenu" Header="属性" Click="RemoteProperties_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="RemoteDeleteMenu" Header="删除" InputGestureText="Del" Click="RemoteDelete_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="名称" Width="200" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn Header="修改时间" Width="150" DisplayMemberBinding="{Binding LastWriteTime, StringFormat=yyyy-MM-dd HH:mm}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 图标视图（平铺，默认显示） -->
                        <ListView x:Name="RemoteIconList" Grid.Row="1"
                                  SelectionMode="Extended"
                                  AllowDrop="True"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  MouseDoubleClick="RemoteFileList_MouseDoubleClick"
                                  Drop="RemoteFileList_Drop"
                                  DragOver="RemoteFileList_DragOver"
                                  PreviewKeyDown="RemoteFileList_PreviewKeyDown"
                                  PreviewMouseRightButtonDown="RemoteFileList_PreviewMouseRightButtonDown"
                                  ContextMenuOpening="RemoteFileList_ContextMenuOpening">
                            <!-- 不自定义 ItemContainerStyle：主题样式（含选中高亮）保持生效，
                                 条目间隔由模板 Margin 控制，整格可命中由模板 Background 保证 -->
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="IconEditMenu" Header="编辑" Click="RemoteQuickEdit_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="IconCopyMenu" Header="复制" InputGestureText="Ctrl+C" Click="RemoteCopy_Click"/>
                                    <MenuItem x:Name="IconPasteMenu" Header="粘贴" InputGestureText="Ctrl+V" Click="RemotePaste_Click"/>
                                    <MenuItem x:Name="IconRenameMenu" Header="重命名" InputGestureText="F2" Click="RemoteRename_Click"/>
                                    <Separator/>
                                    <MenuItem Header="新建文件夹" Click="RemoteNewFolder_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="IconPropertiesMenu" Header="属性" Click="RemoteProperties_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="IconDeleteMenu" Header="删除" InputGestureText="Del" Click="RemoteDelete_Click"/>
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <!-- 条目固定 3:4（宽:高）比例；透明背景保证整格可命中（否则空白处落穿误触发框选） -->
                                    <Grid Width="72" Height="96" Margin="6" Background="Transparent">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <!-- 名称行固定高度：行数不同也不挤压图标，保证所有条目图标同一水平线 -->
                                            <RowDefinition Height="40"/>
                                        </Grid.RowDefinitions>
                                        <Image Grid.Row="0" Source="{Binding Converter={StaticResource FileIcon}}"
                                               Width="48" Height="48" Stretch="Uniform"
                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" TextWrapping="Wrap"
                                                   TextAlignment="Center" VerticalAlignment="Top"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Name}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <!-- 传输遮罩：仅在有传输任务时显示，覆盖并阻断文件管理操作 -->
                <Border x:Name="TransferOverlay" Visibility="Collapsed"
                        Background="#B3FFFFFF">
                    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1"
                            CornerRadius="6" Padding="16" MaxWidth="520"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="正在传输文件…" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="传输完成前文件管理功能不可用。" Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="TransferItems">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                                                    <TextBlock Margin="8,0,0,0" Foreground="Gray" FontSize="11">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} / {1}  {2}">
                                                                <Binding Path="TransferredText"/>
                                                                <Binding Path="SizeText"/>
                                                                <Binding Path="SpeedText"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <ProgressBar IsIndeterminate="{Binding IsIndeterminate}"
                                                             Value="{Binding ProgressPercentage, Mode=OneWay}" Maximum="1"
                                                             Height="14" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="取消" Width="56" Height="24" Margin="10,0,0,0"
                                                    VerticalAlignment="Center" IsEnabled="{Binding IsRunning}"
                                                    Click="TransferCancel_Click">
                                                <!-- 服务器端 shell 操作无传输流可中断，隐藏取消 -->
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIndeterminate}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>